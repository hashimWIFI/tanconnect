{
    frankenphp
    order php_fastcgi before file_server
}

:{$PORT} {
    # Dynamically targets the container root folder cleanly
    root * .
    
    # Internal routing engine to cleanly pass scripts to PHP workers
    route {
        try_files {path} {path}/ /index.php?{query}
        file_server
        php_fastcgi
    }
}
